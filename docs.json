{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Akeba",
  "description": "Documentação da API da Akeba — marketplace de produtos criativos e artesanais feitos por criadores independentes do Brasil.",
  "colors": {
    "primary": "#61005D",
    "light": "#C6B1FF",
    "dark": "#480246"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque"
    },
    "body": {
      "family": "Bricolage Grotesque"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Início",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Guias",
            "pages": [
              "guias/autenticacao",
              "guias/paginacao-e-sincronizacao",
              "guias/fluxo-de-pedidos",
              "guias/webhooks",
              "guias/erros"
            ]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "openapi": {
          "source": "/openapi.json",
          "directory": "api-reference"
        }
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Site da Akeba",
          "href": "https://www.akeba.com.br",
          "icon": "globe"
        },
        {
          "anchor": "Painel do vendedor",
          "href": "https://akeba.com.br/vendedor/integracoes",
          "icon": "key"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "https://www.akeba.com.br"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Painel do vendedor",
      "href": "https://akeba.com.br/vendedor/integracoes"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "instagram": "https://www.instagram.com/akebabr/",
      "website": "https://www.akeba.com.br"
    }
  }
}
